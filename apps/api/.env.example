# CodeSync API — environment variables
# Copy this file to .env and fill in the values.
# Never commit the .env file (it is in .gitignore).

# ── Firebase ──────────────────────────────────────────────────────────────────
# Firebase project ID. For the local emulators use demo-codesync-test (see /RUN.md).
Firebase__ProjectId=demo-codesync-test

# Path to the Firebase service account JSON key downloaded from:
# Firebase Console → Project Settings → Service accounts → Generate new private key
# This file must NEVER be committed to git.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceaccount.json

# ── IA Coach (OpenRouter) ──────────────────────────────────────────────────
# Opcional: sin key el Coach usa hints pre-generados.
# Key gratuita: https://openrouter.ai/keys  (los modelos ":free" no consumen crédito)
OpenRouter__ApiKey=your-openrouter-api-key

# Modelo (default: google/gemma-4-31b-it:free) y fallback ante 404/5xx (default: openrouter/free)
# OpenRouter__Model=google/gemma-4-31b-it:free
# OpenRouter__FallbackModel=openrouter/free

# ── Docker sandbox ────────────────────────────────────────────────────────────
# Docker daemon URI. Optional: defaults to the OS-appropriate one
# (Windows: npipe://./pipe/docker_engine, Linux/macOS: unix:///var/run/docker.sock).
# Docker__EndpointUri=unix:///var/run/docker.sock

# Execution timeout in seconds (default: 5)
# Docker__ExecutionTimeoutSeconds=5

# ── Rate limiting ─────────────────────────────────────────────────────────────
# How long (in minutes) between AI Coach requests per user (default: 1)
# RateLimit__AICoachWindowMinutes=1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allowed origins for the Angular frontend. Separate multiple with commas.
# In production, set this to your actual domain.
# Cors__AllowedOrigins__0=http://localhost:4200
