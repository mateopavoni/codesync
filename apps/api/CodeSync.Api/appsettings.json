{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Firebase": {
    "ProjectId": ""
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-1.5-flash",
    "ApiBaseUrl": "https://generativelanguage.googleapis.com"
  },
  "Docker": {
    "EndpointUri": "npipe://./pipe/docker_engine",
    "ExecutionTimeoutSeconds": 5
  },
  "RateLimit": {
    "AICoachWindowMinutes": 1
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
