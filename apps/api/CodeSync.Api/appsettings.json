{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Firebase": {
    "ProjectId": "",
    "DatabaseUrl": "https://codesync-95667-default-rtdb.firebaseio.com"
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-1.5-flash",
    "ApiBaseUrl": "https://generativelanguage.googleapis.com"
  },
  "Docker": {
    "EndpointUri": "npipe://./pipe/docker_engine",
    "ExecutionTimeoutSeconds": 5,
    "HtmlExecutionTimeoutSeconds": 12
  },
  "RateLimit": {
    "AICoachWindowMinutes": 1
  },
  "DemoCleanup": {
    "IntervalHours": 1,
    "RetentionHours": 24
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:4210"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
